# ==============================================================================
# FOREX MT5 AUTOMATED TRADING SAAS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ==============================================================================
# CATEGORY 1: REQUIRED NOW (Local & Standalone Backend Configuration)
# Define your local secrets in your local .env file.
# Do NOT put real secrets or credentials in this example template file.
# ==============================================================================
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
JWT_SECRET=your-jwt-secret-min-32-chars-long-secure-random
MT5_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DATABASE_URL=postgresql://user:password@localhost:5432/forex_trading_saas
REDIS_URL=redis://localhost:6379

# ==============================================================================
# CATEGORY 2: FRONTEND & CLOUDFLARE PAGES INTEGRATION
# Configure these when decoupling the frontend from the backend server.
# Set VITE_API_BASE_URL in Cloudflare Pages -> Settings -> Environment Variables.
# ==============================================================================
# Backend API Base URL for Cloudflare Pages build:
VITE_API_BASE_URL=https://api.yourdomain.com

# Authorized CORS Origins for the Backend server:
FRONTEND_CUSTOMER_URL=https://forex-mt5-automated-trading.pages.dev
FRONTEND_ADMIN_URL=https://forex-mt5-automated-trading.pages.dev/admin

# ==============================================================================
# CATEGORY 3: REQUIRED LATER (Stripe Subscription Billing & Payments)
# Note: Platform functions in test/mock mode if Stripe keys are omitted.
# ==============================================================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# ==============================================================================
# CATEGORY 4: NOTIFICATIONS & EMAIL GATEWAYS
# ==============================================================================
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=
# NOTIFICATION_FROM_EMAIL=notifications@forexsaas.com

# ==============================================================================
# CATEGORY 5: MT5 WORKER NODES & SOCIAL MEDIA AUTOMATION
# ==============================================================================
# Dedicated secret token for authenticating Windows Python MT5 Worker synchronization (x-worker-secret)
MT5_WORKER_SECRET=your-secure-random-worker-secret-min-32-chars
# MT5_DEFAULT_BROKER_TIMEOUT_MS=15000
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=
# INSTAGRAM_GRAPH_API_ACCESS_TOKEN=
# INSTAGRAM_ACCOUNT_ID=
# ENFORCE_ADMIN_2FA=false
